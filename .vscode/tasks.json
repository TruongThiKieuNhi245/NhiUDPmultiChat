{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: compile",
            "type": "shell",
            "command": "${config:maven.executable.path}",
            "args": ["-q", "compile"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$javac"]
        }
    ]
}
