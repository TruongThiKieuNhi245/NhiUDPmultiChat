# Thay hostname mau bang hostname duoc nguoi dung giao, DNS phai tro dung may.
chat.example.invalid {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-Port
        header_up -X-Forwarded-Prefix
        header_up -X-Forwarded-Ssl
    }
}
